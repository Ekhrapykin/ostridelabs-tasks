{
  "name": "ostridelabs-tasks-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "build:frontend": "npm run build --workspace=packages/frontend",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "build:backend": "npm run build --workspace=packages/backend",
    "db:up": "docker-compose -f packages/backend/docker-compose.yml up -d",
    "db:down": "docker-compose -f packages/backend/docker-compose.yml  down -v",
    "db:restart": "npm run db:down && npm run db:up",
    "db:logs": "docker-compose -f packages/backend/docker-compose.yml logs -f postgres"
  }
}
